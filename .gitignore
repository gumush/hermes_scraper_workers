# Git satır içi yorum tanımaz: "outputs/  # açıklama" satırının tamamı kalıp
# sayılır ve hiçbir şeyle eşleşmez. Açıklamalar bu yüzden kendi satırlarında.

# --- üretilen veri ---
# Teslim edilen paketler (GB'lar), exec durumu ve hata paketleri, run
# tanımları, worker çalışma alanı. Hiçbiri versiyonlanmaz.
outputs/
orchestrator/state/
orchestrator/runs/
spot_out/
logs/
*.log

# Profiller ilk çalıştırmada DEFAULT_PROFILES'tan üretilir; yereldeki
# düzenlemeler kişiseldir.
orchestrator/profiles.json

# Gerçek ayar dosyası; config.sample.yaml versiyonlanır ve VM kurulumunda
# ondan kopyalanır.
config.yaml

# --- kazıma motorunun bıraktıkları ---
# Testler ve SeleniumBase çalışırken bunları üretir.
reviews.db
*.sqlite
*.sqlite3
downloaded_files/
review_images/
place_photos/

# --- çalışma zamanı ---
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- işletim sistemi / editör ---
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/
*.swp
